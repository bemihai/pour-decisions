# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# ChromaDB connection
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Ollama configuration (for local LLM inference)
# Model options: gemma2:2b (1.6GB, fast), phi3:mini (2.3GB), llama3.2:3b (2.0GB), gemma4:e2b (7.2GB)
OLLAMA_MODEL=gemma2:2b
OLLAMA_MEMORY_LIMIT=3G
OLLAMA_BASE_URL=http://localhost:11434

# Optional: CellarTracker import credentials
CELLAR_TRACKER_USERNAME=your_username
CELLAR_TRACKER_PASSWORD=your_password

# Optional: Tavily web search API (free tier: 1000 searches/month)
TAVILY_API_KEY=your_tavily_api_key

# Optional: Phoenix observability (local, self-hosted)
OBSERVABILITY_ENABLED=false
OBSERVABILITY_PROVIDER=phoenix
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_ENDPOINT_DOCKER=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=pour-decisions

# RAG configuration
WINE_BOOKS_PATH=path-to-exteral-data
EMBEDDING_MODEL=sentence-transformers/embedding-model-name

# Optional: enable destructive manual merge endpoints (dev only)
# Must be set on BOTH backend and frontend to enable the Merge Records tab.
# ENABLE_MANUAL_MERGE=true          # read by FastAPI
# NEXT_PUBLIC_ENABLE_MANUAL_MERGE=true  # read by Next.js
